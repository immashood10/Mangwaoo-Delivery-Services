// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Identity ────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?  @unique
  password  String
  role      Role
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// When the WhatsApp number on the account was confirmed with a code. Nobody can log in before this is set
  /// (the admin account is exempt). Accounts that existed before verification was introduced were marked
  /// confirmed when it launched.
  phoneVerifiedAt DateTime?

  /// Set when an admin deleted the account (Admin > Users). Its personal details are erased, so the email and number
  /// can be used to sign up again, and it can never log in again; orders, chats and listings keep pointing at the row.
  deletedAt DateTime?

  /// Sessions issued before this moment no longer work (set when the password is changed or reset), so a stolen
  /// login cookie stops working the moment the real owner changes the password.
  sessionsValidFrom DateTime?

  customer            Customer?
  seller              Seller?
  rider               Rider?
  wallet              Wallet?
  addresses           Address[]
  notifications       Notification[]
  passwordResetTokens PasswordResetToken[]
  productLikes        ProductLike[]
  favourites          Favourite[]
  phoneVerification   PhoneVerification?
  bans                UserBan[]
  supportThread       SupportThread?
  pushSubscriptions   PushSubscription[]
  areaManager         AreaManager?
  asmStartedRiderThreads AreaManagerRiderThread[] @relation("AsmManagerThreads")
  riderAsmThreads        AreaManagerRiderThread[] @relation("AsmRiderThreads")
  asmRiderMessages       AreaManagerRiderMessage[] @relation("AsmRiderMessageSender")
}

/// An Area Sales Manager's post: the service area (`SERVICE_AREAS` id in lib/data.ts) whose order chats they look after. The
/// super admin makes and removes these accounts (Admin > Area Managers); several managers may share an area. The account
/// itself is a `User` with role ASM.
model AreaManager {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  areaId    Int
  createdAt DateTime @default(now())

  @@index([areaId])
}

/// A private conversation between one area manager and one rider. It is separate from Mangwaoo Support and order chats.
model AreaManagerRiderThread {
  id            String   @id @default(cuid())
  managerUserId String
  manager       User     @relation("AsmManagerThreads", fields: [managerUserId], references: [id], onDelete: Cascade)
  riderUserId   String
  rider         User     @relation("AsmRiderThreads", fields: [riderUserId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())
  messages      AreaManagerRiderMessage[]

  @@unique([managerUserId, riderUserId])
  @@index([riderUserId, updatedAt])
}

model AreaManagerRiderMessage {
  id             String   @id @default(cuid())
  threadId       String
  thread         AreaManagerRiderThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderUserId   String
  sender         User     @relation("AsmRiderMessageSender", fields: [senderUserId], references: [id], onDelete: Cascade)
  body           String
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([threadId, createdAt])
}

/// The private chat between the admin team and one seller or rider (Admin > Messages). One thread per account; the
/// admin starts it, and the seller/rider can answer in it. Emptied when the account is deleted.
model SupportThread {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  messages SupportMessage[]
}

model SupportMessage {
  id        String        @id @default(cuid())
  threadId  String
  thread    SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  /// true: written by an admin ("Mangwaoo Support"); false: by the seller/rider
  fromAdmin Boolean
  body      String
  /// Read by the other side (admin messages: by the seller/rider; their messages: by an admin)
  isRead    Boolean       @default(false)
  createdAt DateTime      @default(now())

  @@index([threadId, createdAt])
}

/// A ban an admin put on an account (Admin > Users). While one is running the account can't log in, and sessions it
/// already has stop working within seconds. The row stays after it ends or is lifted, as history.
model UserBan {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// When it ends; null for a permanent ban.
  endsAt        DateTime?
  permanent     Boolean   @default(false)
  /// The length the admin typed, in words ("7 days"): the message the user sees stays "banned for 7 days from Mangwaoo".
  durationLabel String
  /// Shown to the user with the ban message.
  reason        String?
  createdAt     DateTime  @default(now())
  /// Set when the ban was lifted early, or replaced by a new one.
  liftedAt      DateTime?

  @@index([userId, createdAt])
}

enum PhoneVerificationPurpose {
  /// The number the account was created with: signing up, or logging in before it was confirmed.
  ACCOUNT
  /// A new number the customer wants to switch to in Settings; the account keeps its old number until the code is entered.
  CHANGE
}

/// The WhatsApp code an account is waiting to be confirmed with (one at a time per account). The browser holds
/// only an opaque "ticket" in memory while the code screen is open; the database stores the hash of the ticket
/// and a keyed hash of the code, so neither can be read back from the table.
model PhoneVerification {
  id         String                   @id @default(cuid())
  userId     String                   @unique
  user       User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose    PhoneVerificationPurpose
  /// The number the code was sent to, as country-coded digits (923001234567).
  phone      String
  ticketHash String                   @unique
  codeHash   String
  expiresAt  DateTime
  /// Wrong guesses made against the current code; it stops working after a few.
  attempts   Int                      @default(0)
  createdAt  DateTime                 @default(now())
}

/// One row per WhatsApp code actually sent. It limits how often a number (and a network) can be messaged, and it
/// outlives the account on purpose: starting the signup over must not reset the limit. Rows older than a day are purged.
model PhoneVerificationSend {
  id        String   @id @default(cuid())
  phone     String
  /// Keyed hash of the requester's IP address, never the address itself.
  ipHash    String
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
  @@index([ipHash, createdAt])
}

// Reset links are delivered over WhatsApp (no email service configured), so
// the raw token only ever appears in the WhatsApp message itself — the DB
// stores just its hash, same principle as a password hash.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

enum Role {
  CUSTOMER
  SELLER
  RIDER
  ADMIN
  /// Area Sales Manager: gets the order chats of one service area and assigns riders to them (see lib/area-managers.ts).
  ASM
}

enum SellerType {
  MART
  GULPLAZA_OWNER
  WHOLESALER
}

model Customer {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  orders         Order[]
  gulplazaOrders GulplazaOrder[]
  reviews        Review[]
  conversations  Conversation[]
  cartItems      CartItem[]
  riderChats     RiderChat[]
  couponRedemptions CouponRedemption[]
  riderOrderRecords RiderOrderRecord[]

  // ── Mangwaoo Points and the cashback wallet (see lib/points.ts) ──
  /// Points to spend: the sum of the PointsEntry lines. Kept in step with them in the same transaction that changes them.
  points        Int @default(0)
  /// Cashback in whole PKR waiting in the wallet: the sum of the WalletEntry lines (never negative, also checked by the database).
  walletBalance Int @default(0)

  pointsEntries PointsEntry[]
  walletEntries WalletEntry[]
  withdrawals   WalletWithdrawal[]

  // ── Loyalty Card (see lib/loyalty-card.ts) ──
  loyaltyCard        LoyaltyCard?
  loyaltyRedemptions LoyaltyRedemption[]
}

model Seller {
  id           String     @id @default(cuid())
  userId       String     @unique
  user         User       @relation(fields: [userId], references: [id])
  businessName String
  sellerType   SellerType @default(MART)
  isApproved   Boolean    @default(false)
  createdAt    DateTime   @default(now())

  /// GulPlaza-specific identity verification fields, collected at signup for
  /// GULPLAZA_OWNER accounts only and reviewed manually before approval.
  shopNo   String?
  nicImage String?

  /// Where the store is based; shown on its public store page and on its ads.
  country String  @default("Pakistan")
  city    String?

  /// Where the shop / kitchen is on the map. Food search lists the restaurants nearest
  /// to the customer's delivery address first; sellers without a pin are listed last.
  latitude      Float?
  longitude     Float?
  locationLabel String?

  /// When the restaurant's background (cover) picture was last set, null when it has none. The picture itself is in
  /// `SellerCover` (its bytes never ride along with the catalog queries); this date is the `?v=` of its address, so a
  /// new picture is fetched instead of the one the browser kept.
  coverUpdatedAt DateTime?
  cover          SellerCover?

  products         Product[]
  productAds       ProductAd[]
  orders           Order[]
  gulplazaProducts GulplazaProduct[]
  gulplazaOrders   GulplazaOrder[]
  conversations    Conversation[]
  cartItems        CartItem[]
}

/// The background picture of a food seller's restaurant (its page header and its card). The bytes live in their own
/// table so the catalog queries, which load whole seller rows, never carry them.
model SellerCover {
  id        String   @id @default(cuid())
  sellerId  String   @unique
  seller    Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
}

model Rider {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  vehicleType String?
  // Vehicle registration (not required for bicycles) and national ID, both
  // reviewed by an admin together with the CNIC photos before approval.
  numberPlate String?
  cnicNumber  String?  @unique
  isAvailable Boolean  @default(true)
  isApproved  Boolean  @default(false)
  createdAt   DateTime @default(now())

  // Latest GPS fix sent from the rider dashboard while online — used to
  // dispatch new order chats to the nearest riders.
  lastLatitude  Float?
  lastLongitude Float?
  lastSeenAt    DateTime?
  /// When lastLatitude / lastLongitude were last written: by the online heartbeat, or by the location ping a rider sends while
  /// delivering an order (also when they switched themselves offline). The customer's live tracking shows how fresh it is.
  locationUpdatedAt DateTime?

  orders            Order[]
  locations         RiderLocation[]
  deliveryTrackings DeliveryTracking[]
  riderChats        RiderChat[]
  documents         RiderDocument[]

  // ── Wallet: Mangwaoo's commission on every finished order (see lib/rider-wallet.ts) ──
  /// The sum of the ledger in PKR: negative = the rider owes Mangwaoo. Kept in step with the ledger in the same
  /// transaction that changes it.
  walletBalance Int              @default(0)
  /// Finished orders whose commission is not covered by payments yet (oldest are covered first).
  unpaidOrders  Int              @default(0)
  /// Set when unpaid orders reached the limit; cleared once the rider has paid up (balance back to 0 or more).
  paymentHold   Boolean          @default(false)
  /// An admin's decision on whether the rider may receive the next order (AUTO = the wallet rule decides).
  orderAccess   RiderOrderAccess @default(AUTO)

  ledger RiderLedgerEntry[]
  topUps RiderTopUp[]

  orderRecords RiderOrderRecord[]
}

enum RiderOrderAccess {
  AUTO
  ALLOWED
  BLOCKED
}

enum RiderLedgerType {
  COMMISSION
  TOP_UP
  ADJUSTMENT
  /// A random bonus Mangwaoo pays for a delivered order (see lib/rider-bonus.ts). Positive money on the rider's side, so it is
  /// set off against the commission the rider owes, like a payment.
  BONUS
}

enum RiderTopUpStatus {
  PENDING
  APPROVED
  REJECTED
}

/// One line of a rider's wallet. `amount` is in PKR from the rider's side: a top-up is positive, a commission negative.
model RiderLedgerEntry {
  id         String          @id @default(cuid())
  riderId    String
  rider      Rider           @relation(fields: [riderId], references: [id], onDelete: Cascade)
  type       RiderLedgerType
  amount     Int
  /// COMMISSION: the delivery charge the commission was taken from.
  baseAmount Int?
  /// COMMISSION: the order chat it belongs to. A plain id, not a relation, so deleting a chat keeps the money record;
  /// unique = one commission per order, however many times it is closed.
  chatId     String?         @unique
  /// TOP_UP made from a rider's recharge request.
  topUpId    String?         @unique
  /// BONUS: the order chat the bonus was paid for. A plain id like `chatId`; unique = one bonus per order.
  bonusChatId String?        @unique
  note       String?
  createdAt  DateTime        @default(now())

  @@index([riderId, createdAt])
}

/// A rider's "I sent Mangwaoo this money" request (EasyPaisa / JazzCash transaction id), checked by an admin.
model RiderTopUp {
  id              String           @id @default(cuid())
  riderId         String
  rider           Rider            @relation(fields: [riderId], references: [id], onDelete: Cascade)
  amount          Int
  method          String
  transactionId   String
  status          RiderTopUpStatus @default(PENDING)
  rejectionReason String?
  reviewedAt      DateTime?
  createdAt       DateTime         @default(now())

  /// The screenshot of the payment the rider attached (optional).
  screenshot RiderTopUpScreenshot?

  @@index([status, createdAt])
  @@index([riderId, createdAt])
  @@index([transactionId])
}

/// The photo a rider attached to a recharge request (a screenshot of the payment). The bytes live in their own table so
/// lists of requests never load them; only admins can view it.
model RiderTopUpScreenshot {
  id        String     @id @default(cuid())
  topUpId   String     @unique
  topUp     RiderTopUp @relation(fields: [topUpId], references: [id], onDelete: Cascade)
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime   @default(now())
}

/// The commission rule, editable by an admin (Admin > Rider Wallets). A single row with id "default".
model RiderWalletSettings {
  id                String   @id @default("default")
  /// Mangwaoo's share of each finished order's delivery charge, in percent.
  commissionPercent Int      @default(30)
  /// How many finished orders may be unpaid before the rider must pay up to get the next one.
  ordersOnCredit    Int      @default(5)
  updatedAt         DateTime @updatedAt
}

/// The delivery bonus rule, editable by an admin (Admin > Rider Wallets). A single row with id "default". A rider who completes an
/// order gets a random bonus (whole PKR) that depends on how far the order was: up to `nearMaxKm` (judged to 0.1 km) a number
/// from nearMin to nearMax, up to `midMaxKm` one from midMin to midMax, beyond that one from farMin to farMax.
model RiderBonusSettings {
  id        String   @id @default("default")
  /// Off = no new bonuses; the ones already paid stay.
  enabled   Boolean  @default(true)
  nearMaxKm Float    @default(3)
  midMaxKm  Float    @default(5)
  nearMin   Int      @default(1)
  nearMax   Int      @default(20)
  midMin    Int      @default(1)
  midMax    Int      @default(50)
  farMin    Int      @default(50)
  farMax    Int      @default(100)
  updatedAt DateTime @updatedAt
}

enum RiderDocumentKind {
  CNIC_FRONT
  CNIC_BACK
  /// A clear photo of the rider's face, required at signup (only admins can view it).
  FACE
}

/// Identity document photos uploaded at rider signup; only admins can view them.
model RiderDocument {
  id        String            @id @default(cuid())
  riderId   String
  rider     Rider             @relation(fields: [riderId], references: [id], onDelete: Cascade)
  kind      RiderDocumentKind
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime          @default(now())

  @@unique([riderId, kind])
}

// ── Catalog ─────────────────────────────────────────────────

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  imageUrl String?
  products Product[]
}

model Product {
  id          String   @id @default(cuid())
  // Public 10-digit "Ad ID" shown on the ad page (the cuid stays the URL key)
  adNumber    Int      @unique @default(autoincrement())
  name        String
  description String?
  price       Decimal
  stock       Int      @default(0)
  images      String[] @default([])
  // Category-specific details, e.g. a vehicle ad's make/model/year (see lib/vehicle-details.ts)
  attributes  Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  sellerId   String
  seller     Seller   @relation(fields: [sellerId], references: [id])
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  orderItems OrderItem[]
  reviews    Review[]
  likes      ProductLike[]
  ads        ProductAd[]
}

enum AdPlacement {
  // The ad column on the right of MangwaooMart
  SIDEBAR
  // The "Featured" rows on the home page and at the top of MangwaooMart
  MAIN_PAGE
  // A story on the Mangwaoo logo for one day (a Story row is made when an admin approves it)
  STORY
}

enum AdStatus {
  // Requested and paid for by the seller; waiting for an admin to check the payment
  PENDING
  // Approved: runs from startsAt to endsAt
  ACTIVE
  REJECTED
}

/// A seller paying to feature one of their products for a week (see lib/ad-config.ts).
model ProductAd {
  id              String      @id @default(cuid())
  placement       AdPlacement
  status          AdStatus    @default(PENDING)
  // PKR charged, fixed at the time of the request
  amount          Int
  // The seller's EasyPaisa / JazzCash transaction id, checked by an admin
  paymentRef      String
  rejectionReason String?
  // Set when an admin approves: the ad runs for a week from then
  startsAt        DateTime?
  endsAt          DateTime?
  reviewedAt      DateTime?
  // Set when an admin deletes an ended or declined request from the Ad Requests list. The row stays,
  // so a transaction id that was paid for can't be used for another ad.
  deletedAt       DateTime?
  createdAt       DateTime    @default(now())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sellerId  String
  seller    Seller  @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  /// The story a STORY ad is shown as while it runs.
  story Story?

  @@index([status, placement, endsAt])
  @@index([sellerId, createdAt])
}

/// A signed-in user's "like" (heart) on an ad; one per user and ad.
model ProductLike {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([productId])
}

enum FavouriteKind {
  RESTAURANT
  DISH
}

/// A restaurant or dish a signed-in user saved with the heart button, so it is quick to find and order again.
/// Liked MangwaooMart ads (ProductLike) show up on the same Favourites page.
model Favourite {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      FavouriteKind
  /// The Seller id (RESTAURANT) or GulplazaProduct id (DISH). No foreign key: items that are later
  /// unlisted are simply left out when the list is shown.
  targetId  String
  createdAt DateTime      @default(now())

  @@unique([userId, kind, targetId])
  @@index([userId, createdAt])
}

// ── Ordering ────────────────────────────────────────────────

model Order {
  id           String      @id @default(cuid())
  /// The number customers and sellers see (MW-M10001); starts at 10001, never reused.
  orderNumber  Int         @unique @default(autoincrement())
  status       OrderStatus @default(PENDING)
  /// The items only (what the seller earns). The customer pays this minus `discountAmount`; MangwaooMart orders have no delivery fee.
  totalAmount  Decimal
  /// Taken off by the coupon and the Loyalty Card together (paid by Mangwaoo, not the seller); `loyaltyDiscount` is the card's part
  discountAmount Decimal   @default(0)
  // Optional message from the customer to the vendor, entered at checkout
  note         String?
  // The seller removed this finished order from their dashboard (the customer's history is untouched)
  sellerHidden Boolean     @default(false)
  // When the seller marked it delivered; "products sold" in the seller's stats counts from here
  deliveredAt  DateTime?
  // When the order reached each of the other steps (the live tracking page's timeline, lib/order-tracking.ts); null = not
  // reached, or reached before tracking existed
  confirmedAt      DateTime?
  preparingAt      DateTime?
  outForDeliveryAt DateTime?
  cancelledAt      DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  sellerId   String
  seller     Seller   @relation(fields: [sellerId], references: [id])
  riderId    String?
  rider      Rider?   @relation(fields: [riderId], references: [id])
  addressId  String
  address    Address  @relation(fields: [addressId], references: [id])
  couponId   String?
  coupon     Coupon?  @relation(fields: [couponId], references: [id])
  redemptionId String?
  redemption CouponRedemption? @relation(fields: [redemptionId], references: [id])
  /// The Loyalty Card discount of this order: its share in PKR (part of `discountAmount`), the % the card drew, and the
  /// checkout it belongs to (so it can be given back when every order of that checkout is cancelled).
  loyaltyDiscount     Decimal            @default(0)
  loyaltyPercent      Int?
  loyaltyRedemptionId String?
  loyaltyRedemption   LoyaltyRedemption? @relation(fields: [loyaltyRedemptionId], references: [id], onDelete: SetNull)
  riderChatId String?
  riderChat RiderChat? @relation("RiderChatMartOrders", fields: [riderChatId], references: [id], onDelete: SetNull)

  items    OrderItem[]
  payment  Payment?
  tracking DeliveryTracking?

  @@index([riderChatId])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model OrderItem {
  id       String  @id @default(cuid())
  quantity Int
  price    Decimal

  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
}

// ── Messaging ───────────────────────────────────────────────
// One running thread per customer-seller pair, shared across both
// MangwaooMart and GulPlaza products from that seller rather than
// fragmenting into a separate thread per product.

model Conversation {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  sellerId    String
  seller      Seller   @relation(fields: [sellerId], references: [id])
  productName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages Message[]

  @@unique([customerId, sellerId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderRole     SenderRole
  body           String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
}

// ── Order chat: customer ↔ nearest rider (admin can join) ──

model RiderChat {
  id              String          @id @default(cuid())
  customerId      String
  customer        Customer        @relation(fields: [customerId], references: [id])
  // null while OPEN; set to the first nearby rider who replies
  riderId         String?
  rider           Rider?          @relation(fields: [riderId], references: [id])
  // Drop-off (delivery) location
  latitude        Float
  longitude       Float
  addressText     String
  // Pickup location (where the rider collects the order). Null on chats
  // created before pickup was asked for; riders are dispatched by this point.
  pickupLatitude  Float?
  pickupLongitude Float?
  pickupText      String?
  // The delivery charge of the checkout(s) that opened this chat, in whole PKR, worked out by the server (the food
  // delivery fees). null = the chat did not come from a checkout: its charge is then the delivery rate for the ride
  // from the pickup to the drop-off (minimumFeeForChat). Mangwaoo's commission is a percentage of this.
  deliveryCharge  Int?
  // How far the ride is, in km (judged to 0.1 km): the longest restaurant → customer distance of the checkout(s) that opened
  // the chat, or the pickup → drop-off distance of a chat with a pickup point. null = not known (MangwaooMart only, older chats).
  // The tier of the rider's delivery bonus follows it.
  deliveryDistanceKm Float?
  status          RiderChatStatus @default(OPEN)
  claimedAt       DateTime?
  // The service area (SERVICE_AREAS id) whose Area Sales Manager assigns the rider of this order: set for a chat the customer
  // started with the Chat button while that area had a manager. While OPEN, riders do not see such a chat; the manager picks
  // one. null = the first rider to reply takes it (checkout orders, and areas without a manager).
  areaId          Int?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  messages    RiderChatMessage[]
  attachments RiderChatAttachment[]
  martOrders  Order[] @relation("RiderChatMartOrders")
  foodOrders  GulplazaOrder[] @relation("RiderChatFoodOrders")

  @@index([status])
  @@index([areaId, status])
}

enum RiderChatStatus {
  OPEN
  ACTIVE
  CLOSED
}

/// How an order a rider took ended (the ones still going are read live from the order chats).
enum RiderOrderStatus {
  DELIVERED
  CANCELLED
  /// Closed by Mangwaoo without a delivery being confirmed (an admin closed the chat, the customer's account was removed).
  CLOSED
}

enum RiderOrderCancelledBy {
  RIDER
  CUSTOMER
  ADMIN
}

/// One line of a rider's order history: an order the rider took and how it ended, plus what the customer said about the
/// ride afterwards (the rating shown to customers, a comment for the rider, a complaint only admins read).
/// `chatId` is a plain id, not a relation: cancelling an order (or an admin deleting the chat) removes the chat, but the
/// history line stays. Orders still in progress have no line yet; they are read live from the order chats.
model RiderOrderRecord {
  id             String                 @id @default(cuid())
  riderId        String
  rider          Rider                  @relation(fields: [riderId], references: [id])
  customerId     String
  customer       Customer               @relation(fields: [customerId], references: [id])
  chatId         String                 @unique
  /// The customer's name and the route as they were then (the account can change or be removed later).
  customerName   String
  pickupText     String?
  addressText    String
  status         RiderOrderStatus
  cancelledBy    RiderOrderCancelledBy?
  /// Delivered orders: the delivery charge in whole PKR and what Mangwaoo took from it.
  deliveryCharge Int?
  commission     Int?
  /// Delivered orders: the delivery bonus Mangwaoo paid for it, in whole PKR (null = none: before bonuses existed, or switched off).
  bonus          Int?
  takenAt        DateTime
  endedAt        DateTime               @default(now())

  /// The customer's rating of the ride, 1 to 5 (null = not rated). Only a delivered order can be rated, once.
  stars               Int?
  /// What the customer said about the ride (the rider sees it).
  ratingComment       String?
  /// A problem the customer reported (only admins see it).
  complaint           String?
  ratedAt             DateTime?
  complaintResolvedAt DateTime?

  @@index([riderId, endedAt])
  @@index([riderId, status])
  @@index([ratedAt])
}

model RiderChatMessage {
  id           String               @id @default(cuid())
  chatId       String
  chat         RiderChat            @relation(fields: [chatId], references: [id])
  type         RiderChatMessageType @default(TEXT)
  senderRole   RiderChatSender
  senderName   String
  body         String
  // LOCATION messages
  latitude     Float?
  longitude    Float?
  // VOICE messages
  durationSec  Int?
  // IMAGE / VOICE messages — the file bytes live in their own table so
  // message lists never load blobs
  attachmentId String?              @unique
  attachment   RiderChatAttachment? @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  createdAt    DateTime             @default(now())

  @@index([chatId, createdAt])
}

enum RiderChatMessageType {
  TEXT
  IMAGE
  VOICE
  LOCATION
}

model RiderChatAttachment {
  id        String    @id @default(cuid())
  chatId    String
  chat      RiderChat @relation(fields: [chatId], references: [id])
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime  @default(now())

  message RiderChatMessage?

  @@index([chatId])
}

enum RiderChatSender {
  CUSTOMER
  RIDER
  ADMIN
}

enum SenderRole {
  CUSTOMER
  SELLER
  /// An admin joining a customer-seller chat (shown as "Mangwaoo Support")
  ADMIN
}

// A signed-in customer's cart. This is the cart of record (nothing is kept in the browser): it is loaded
// after login and replaced wholesale on every change (see /api/cart). Because it is in the database,
// a seller also sees "pending — still in cart" demand for their products even before (or instead of)
// a real Order gets placed. Rows are deleted once the customer checks out.
model CartItem {
  id          String          @id @default(cuid())
  customerId  String
  customer    Customer        @relation(fields: [customerId], references: [id])
  sellerId    String
  seller      Seller          @relation(fields: [sellerId], references: [id])
  marketplace CartMarketplace
  productId   String
  productName String
  price       Decimal
  quantity    Int
  // Set when the seller removes this from their "Pending — still in cart" list;
  // it comes back only if the customer changes the quantity.
  dismissedAt DateTime?
  updatedAt   DateTime        @updatedAt
  createdAt   DateTime        @default(now())

  @@unique([customerId, productId, marketplace])
}

enum CartMarketplace {
  MART
  GULPLAZA
}

/// An anonymous browser. It is identified by an opaque cookie whose random token is never stored — only
/// its SHA-256 hash is the id here — so everything the site remembers about a visitor lives in the
/// database and nothing is kept in the browser's own storage (localStorage and friends).
model Visitor {
  id         String   @id
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  /// When the first-visit "where should we deliver?" question was answered (or dismissed).
  locationPromptedAt DateTime?

  /// The delivery location the visitor last shared or confirmed.
  lastLatitude      Float?
  lastLongitude     Float?
  lastLocationLabel String?
  lastPostalCode    String?

  @@index([lastSeenAt])
}

enum StoryKind {
  /// A photo with an optional caption.
  IMAGE
  /// A message on a coloured background.
  TEXT
}

/// A WhatsApp-status style story the admin puts on the website logo. Everyone can open it from the logo
/// until `expiresAt` (a day after it was posted), then it disappears.
model Story {
  id         String     @id @default(cuid())
  kind       StoryKind
  /// The caption under a photo, or the message of a TEXT story.
  caption    String?
  /// TEXT stories only: a background colour key from lib/story-types.ts.
  background String?
  /// IMAGE stories only: the photo, served by /api/stories/[id]/image.
  mimeType   String?
  size       Int?
  data       Bytes?
  /// Where a tap on the story's button goes (an internal path). Ad stories link to their product.
  href       String?
  /// Set for a paid "Story ad": the ad it was made from. Such a story is managed through Ad Requests.
  adId       String?    @unique
  ad         ProductAd? @relation(fields: [adId], references: [id], onDelete: Cascade)
  createdAt  DateTime   @default(now())
  expiresAt  DateTime

  views StoryView[]

  @@index([expiresAt])
}

/// One viewer having watched one story (the admin sees the count, and the logo ring turns grey once
/// a viewer has seen everything).
model StoryView {
  id        String   @id @default(cuid())
  storyId   String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  /// "u:<user id>" for a logged-in account (follows it to any device), "v:<Visitor id>" for an anonymous browser.
  viewerKey String
  createdAt DateTime @default(now())

  @@unique([storyId, viewerKey])
  @@index([viewerKey])
}

// ── GulPlaza Marketplace ────────────────────────────────────
// A separate catalog + order flow restricted to approved Gulplaza owners
// and wholesalers (Seller.sellerType). Kept independent of Product/Order
// rather than reusing them, since GulPlaza listings and orders are gated
// to a different seller population than general MangwaooMart vendors.

model GulplazaCategory {
  id       String            @id @default(cuid())
  name     String            @unique
  imageUrl String?
  products GulplazaProduct[]
}

model GulplazaProduct {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Decimal
  stock       Int      @default(0)
  images      String[] @default([])
  /// A dish sold by weight: the sizes on offer with a price each, e.g. [{"grams":250,"price":300},{"grams":1000,"price":1000}]
  /// (read and checked through lib/food-portions.ts). Null = a dish with one price. `price` then holds the lowest size's
  /// price, so every list can say "From PKR ...".
  portions    Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  sellerId   String
  seller     Seller           @relation(fields: [sellerId], references: [id])
  categoryId String
  category   GulplazaCategory @relation(fields: [categoryId], references: [id])

  orderItems GulplazaOrderItem[]
}

model GulplazaOrder {
  id           String      @id @default(cuid())
  /// The number customers and sellers see (MW-F10001); starts at 10001, never reused.
  orderNumber  Int         @unique @default(autoincrement())
  status       OrderStatus @default(PENDING)
  /// The dishes only (what the seller earns). The customer pays this minus `discountAmount` plus `deliveryFee`.
  totalAmount  Decimal
  /// Fuel cost of the ride from the restaurant to the customer (see lib/delivery.ts), paid to the rider
  deliveryFee  Decimal     @default(0)
  /// Taken off by the coupon and the Loyalty Card together (paid by Mangwaoo, not the seller); `loyaltyDiscount` is the card's part
  discountAmount Decimal   @default(0)
  // Optional message from the customer to the vendor, entered at checkout
  note         String?
  // The seller removed this finished order from their dashboard (the customer's history is untouched)
  sellerHidden Boolean     @default(false)
  // When the seller marked it delivered; "products sold" in the seller's stats counts from here
  deliveredAt  DateTime?
  // When the order reached each of the other steps (the live tracking page's timeline, lib/order-tracking.ts); null = not
  // reached, or reached before tracking existed
  confirmedAt      DateTime?
  preparingAt      DateTime?
  outForDeliveryAt DateTime?
  cancelledAt      DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  sellerId   String
  seller     Seller   @relation(fields: [sellerId], references: [id])
  addressId  String
  address    Address  @relation(fields: [addressId], references: [id])
  couponId   String?
  coupon     Coupon?  @relation(fields: [couponId], references: [id])
  redemptionId String?
  redemption CouponRedemption? @relation(fields: [redemptionId], references: [id])
  /// The Loyalty Card discount of this order: its share in PKR (part of `discountAmount`), the % the card drew, and the
  /// checkout it belongs to (so it can be given back when every order of that checkout is cancelled).
  loyaltyDiscount     Decimal            @default(0)
  loyaltyPercent      Int?
  loyaltyRedemptionId String?
  loyaltyRedemption   LoyaltyRedemption? @relation(fields: [loyaltyRedemptionId], references: [id], onDelete: SetNull)
  riderChatId String?
  riderChat RiderChat? @relation("RiderChatFoodOrders", fields: [riderChatId], references: [id], onDelete: SetNull)

  items   GulplazaOrderItem[]
  payment GulplazaPayment?

  @@index([riderChatId])
}

model GulplazaOrderItem {
  id       String  @id @default(cuid())
  quantity Int
  /// The price of one (of the size ordered, for a dish sold by weight)
  price    Decimal
  /// A dish sold by weight: the size ordered, in grams. Null = a dish with one price.
  portionGrams Int?

  orderId   String
  order     GulplazaOrder   @relation(fields: [orderId], references: [id])
  productId String
  product   GulplazaProduct @relation(fields: [productId], references: [id])
}

model GulplazaPayment {
  id        String        @id @default(cuid())
  amount    Decimal
  method    PaymentMethod
  status    PaymentStatus @default(PENDING)
  createdAt DateTime      @default(now())

  orderId String        @unique
  order   GulplazaOrder @relation(fields: [orderId], references: [id])
}

// ── Payments & Wallet ───────────────────────────────────────

model Payment {
  id        String        @id @default(cuid())
  amount    Decimal
  method    PaymentMethod
  status    PaymentStatus @default(PENDING)
  createdAt DateTime      @default(now())

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  CARD
  WALLET
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Wallet {
  id        String   @id @default(cuid())
  balance   Decimal  @default(0)
  createdAt DateTime @default(now())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  transactions Transaction[]
}

model Transaction {
  id        String          @id @default(cuid())
  amount    Decimal
  type      TransactionType
  note      String?
  createdAt DateTime        @default(now())

  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id])
}

enum TransactionType {
  CREDIT
  DEBIT
}

// ── Addresses, Reviews, Coupons, Notifications ─────────────

model Address {
  id        String   @id @default(cuid())
  label     String?
  street    String
  city      String
  latitude  Float?
  longitude Float?
  isDefault Boolean  @default(false)
  // true = saved by the customer from the address picker (Home/Office/...);
  // false = one-off snapshot created when an order is placed
  isSaved   Boolean  @default(false)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  orders         Order[]
  gulplazaOrders GulplazaOrder[]
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
}

enum CouponScope {
  ALL
  FOOD
  MART
}

/// A discount code the admin makes (Admin > Discount). The customer enters it in the cart before checking out;
/// it takes `discountPercent` off the items (never the delivery fee), and Mangwaoo bears the cost: the seller is
/// still paid the full item price.
model Coupon {
  id                String      @id @default(cuid())
  /// Stored in capitals; customers can type it in any case.
  code              String      @unique
  /// Shown to the admin, and to the customer once the code is applied (e.g. "Eid offer").
  description       String?
  discountPercent   Float
  /// The most one order can be reduced by, in PKR; null = no cap.
  maxDiscountAmount Decimal?
  /// The items it applies to must add up to at least this many PKR; null = no minimum.
  minOrderAmount    Decimal?
  appliesTo         CouponScope @default(ALL)
  onePerCustomer    Boolean     @default(true)
  maxUses           Int?
  /// Checkouts that used it and were not cancelled entirely.
  usedCount         Int         @default(0)
  expiresAt         DateTime?
  isActive          Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  orders         Order[]
  gulplazaOrders GulplazaOrder[]
  redemptions    CouponRedemption[]
}

/// One row per checkout that used a coupon (a checkout can create several orders). It is what "used once" and the
/// usage limit count, and it is given back (`cancelledAt`) when every order of the checkout ends up cancelled.
model CouponRedemption {
  id          String    @id @default(cuid())
  couponId    String
  coupon      Coupon    @relation(fields: [couponId], references: [id])
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id])
  createdAt   DateTime  @default(now())
  cancelledAt DateTime?

  orders         Order[]
  gulplazaOrders GulplazaOrder[]

  @@index([couponId, customerId])
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  message   String
  // Dashboard page the notification is about (e.g. /seller/cart); opening that page marks it seen
  href      String?
  // Groups repeat events (same customer + product, same chat) into one unread notification
  refId     String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

enum NotificationType {
  CART
  ORDER
  MESSAGE
  LIKE
  ACCOUNT
  AD
}

// ── Delivery Tracking ───────────────────────────────────────

model DeliveryTracking {
  id        String   @id @default(cuid())
  status    String
  latitude  Float?
  longitude Float?
  updatedAt DateTime @updatedAt

  orderId String  @unique
  order   Order   @relation(fields: [orderId], references: [id])
  riderId String?
  rider   Rider?  @relation(fields: [riderId], references: [id])
}

model RiderLocation {
  id         String   @id @default(cuid())
  latitude   Float
  longitude  Float
  recordedAt DateTime @default(now())

  riderId String
  rider   Rider  @relation(fields: [riderId], references: [id])
}

/// Counters behind the request limits (login, signup, contact, messages…). One row per limit + person (the key is a
/// SHA-256 hash, so no email or IP address is stored); the count restarts when its window is over.
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime

  @@index([windowStart])
}

/// A browser/phone that agreed to receive push notifications for an account (Web Push). The endpoint is the address of
/// the browser's push service; the two keys let the server encrypt a message only that browser can read. Removed at
/// logout, when the push service says the device is gone, and when the account is deleted.
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String    @unique
  p256dh     String
  auth       String
  createdAt  DateTime  @default(now())
  lastSentAt DateTime?

  @@index([userId])
}

// ── Mangwaoo Points: random points on every delivered order, cashback into a wallet, payout to JazzCash / EasyPaisa ──

enum PointsEntryType {
  /// Points won for a delivered order
  EARNED
  /// Points spent on a cashback
  REDEEMED
  /// A correction made by hand
  ADJUSTMENT
}

/// One line of a customer's points. `points` is positive when earned and negative when spent.
model PointsEntry {
  id         String          @id @default(cuid())
  customerId String
  customer   Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type       PointsEntryType
  points     Int
  /// EARNED: the order the points were won for ('MART' or 'GULPLAZA') and its id. Plain values, not relations, so the line
  /// outlives the order; unique, so an order can win points only once however many times it is looked at.
  orderKind  String?
  orderId    String?
  /// EARNED: the order number the customer knows it by (MW-F10001).
  orderRef   String?
  /// REDEEMED: the cashback in PKR those points turned into.
  cashback   Int?
  note       String?
  createdAt  DateTime        @default(now())

  @@unique([orderKind, orderId])
  @@index([customerId, createdAt])
}

enum WalletEntryType {
  /// Cashback from redeemed points
  CASHBACK
  /// Money taken out to the customer's JazzCash / EasyPaisa (a withdrawal request)
  WITHDRAWAL
  /// A withdrawal that was turned down: the money is back
  WITHDRAWAL_REFUND
  /// A correction made by hand
  ADJUSTMENT
}

/// One line of a customer's wallet. `amount` is whole PKR from the customer's side: cashback is positive, a withdrawal negative.
model WalletEntry {
  id           String          @id @default(cuid())
  customerId   String
  customer     Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type         WalletEntryType
  amount       Int
  /// WITHDRAWAL and WITHDRAWAL_REFUND: the request they belong to.
  withdrawalId String?
  note         String?
  createdAt    DateTime        @default(now())

  @@index([customerId, createdAt])
  @@index([withdrawalId])
}

enum WithdrawalStatus {
  /// Asked for; Mangwaoo has not sent the money yet
  PENDING
  /// Mangwaoo sent the money to the customer's account
  PAID
  /// Turned down; the money went back to the wallet
  REJECTED
}

enum PayoutMethod {
  EASYPAISA
  JAZZCASH
}

/// A customer's request to move wallet money to their own JazzCash / EasyPaisa account. The amount leaves the wallet when
/// it is asked for; an admin sends the money by hand and marks it paid (with the transaction id), or turns it down and the
/// amount goes back.
model WalletWithdrawal {
  id              String           @id @default(cuid())
  customerId      String
  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount          Int
  method          PayoutMethod
  /// The customer's mobile account, as 03001234567.
  accountNumber   String
  /// The name on that account, so the admin can check it before sending.
  accountName     String
  status          WithdrawalStatus @default(PENDING)
  /// PAID: the transaction id of the money Mangwaoo sent.
  transactionId   String?
  rejectionReason String?
  /// The admin who paid or rejected it (a plain id).
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime         @default(now())

  @@index([status, createdAt])
  @@index([customerId, createdAt])
}

/// The rules of Mangwaoo Points, editable by an admin (Admin > Wallet Payouts). A single row with id "default".
model LoyaltySettings {
  id             String   @id @default("default")
  /// Off = no new points and no cashing in; balances stay and withdrawals still work.
  enabled        Boolean  @default(true)
  /// A delivered order wins a random number of points from pointsMin to pointsMax.
  pointsMin      Int      @default(1)
  pointsMax      Int      @default(100)
  /// Points one cashback costs.
  redeemPoints   Int      @default(500)
  /// A cashback is a random number of rupees from cashbackMin to cashbackMax.
  cashbackMin    Int      @default(1)
  cashbackMax    Int      @default(10)
  /// The least a customer can withdraw at once (PKR).
  minWithdrawal  Int      @default(1)
  /// Orders with items worth less than this win no points (PKR; 0 = every delivered order wins).
  minOrderAmount Int      @default(0)
  updatedAt      DateTime @updatedAt
}

// ── Loyalty Card (see lib/loyalty-card.ts) ──────────────────

enum LoyaltyCardStatus {
  /// Delivered enough orders to apply; has not applied yet
  ELIGIBLE
  /// Applied; waiting for an admin
  PENDING
  /// The card is active: every order gets a surprise discount
  APPROVED
  /// An admin turned the application down (the customer may apply again)
  REJECTED
  /// An admin took the card back
  REVOKED
}

/// A customer's Mangwaoo Loyalty Card: one row per customer, from the moment they are eligible (after enough delivered
/// orders) through their application and the admin's decision to, once approved, a random discount on every order.
model LoyaltyCard {
  id           String            @id @default(cuid())
  customerId   String            @unique
  customer     Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// The number on the card (MW-LC10001): numbered by the database in the order the rows are made, never reused.
  cardNumber   Int               @unique @default(autoincrement())
  status       LoyaltyCardStatus @default(ELIGIBLE)
  /// APPROVED: the discount % (random, from the rules' range) the customer's NEXT order gets. Drawn when the card is
  /// approved and again each time an order uses it; given back when every order of that checkout is cancelled.
  nextPercent  Int?
  eligibleAt   DateTime          @default(now())
  appliedAt    DateTime?
  approvedAt   DateTime?
  /// The admin who approved, turned down or took back the card (a plain id), and when.
  reviewedById String?
  reviewedAt   DateTime?
  /// The reason the admin gave for turning the application down or taking the card back.
  note         String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  redemptions LoyaltyRedemption[]

  @@index([status, appliedAt])
}

/// One row per checkout that used a Loyalty Card discount (a checkout can create several orders). `percent` is what the
/// card drew, `amount` what it took off in PKR; `releasedAt` is set when every order of the checkout ended up cancelled
/// (the percent then goes back on the card, like a coupon use).
model LoyaltyRedemption {
  id         String      @id @default(cuid())
  cardId     String
  card       LoyaltyCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  percent    Int
  amount     Int
  createdAt  DateTime    @default(now())
  releasedAt DateTime?

  orders         Order[]
  gulplazaOrders GulplazaOrder[]

  @@index([cardId, createdAt])
  @@index([customerId])
}

/// The rules of the Loyalty Card, editable by an admin (Admin > Loyalty Cards). A single row with id "default".
model LoyaltyCardSettings {
  id             String   @id @default("default")
  /// Off = no new invitations or applications and no discounts; cards stay as they are.
  enabled        Boolean  @default(true)
  /// Delivered orders a customer needs before they can apply.
  ordersRequired Int      @default(20)
  /// Every order of a card holder gets a random discount from percentMin to percentMax percent.
  percentMin     Int      @default(1)
  percentMax     Int      @default(10)
  /// The most one checkout can be reduced by (PKR); 0 = no limit.
  maxDiscount    Int      @default(0)
  updatedAt      DateTime @updatedAt
}
